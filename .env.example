# Copy this file to .env and fill in real values. Never commit .env.
# All variables below are validated at server startup (see src/lib/env.ts /
# src/instrumentation.ts) a missing or malformed required value fails fast
# with a clear error instead of breaking deep inside a request.

# --- Database (PostgreSQL, e.g. Neon or Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# The canonical URL Auth.js should use for callbacks. Required in production;
# in production this must NOT be localhost.
AUTH_URL="https://clauselens.org"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Anthropic (contract analysis) ---
ANTHROPIC_API_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""

# --- Resend (transactional email: contact form, password reset, email verification) ---
# Sign up at https://resend.com, verify the clauselens.org domain, then paste the API key below.
RESEND_API_KEY=""
# Optional defaults to "ClauseLens <noreply@clauselens.org>" if unset.
EMAIL_FROM="ClauseLens <noreply@clauselens.org>"

# --- App ---
# Public base URL used to build absolute links (reset/verification emails,
# share links, canonical URLs). Must NOT be localhost in production.
NEXT_PUBLIC_APP_URL="https://clauselens.org"

# --- Upstash Redis (centralized rate limiting) ---
# Optional locally, but required in production for rate limiting to actually
# take effect. If unset: expensive AI routes (analyze/extract/negotiate)
# fail closed (reject requests); other routes fail open (allow requests) —
# see src/lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
