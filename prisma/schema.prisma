generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  planRenewsAt         DateTime?
  // Real Stripe subscription status (active, past_due, canceled, ...) — see src/lib/subscription.ts
  subscriptionStatus   String?
  // Usage metering: analyses used in the current calendar month
  analysesThisMonth    Int       @default(0)
  usageResetAt         DateTime  @default(now())
  // Bumped on password change/reset to invalidate every previously-issued JWT session.
  sessionVersion       Int       @default(0)
  isAdmin              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  accounts             Account[]
  sessions             Session[]
  contracts            Contract[]
  playbookRules        PlaybookRule[]
}

// Business-tier feature: a user's own "red lines" — every analysis is
// checked against each active rule (e.g. "never accept net-90 payment terms").
model PlaybookRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
}

model Contract {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  // Raw contract text (files are parsed client/server side before storage)
  body             String     @db.Text
  // Optional context that sharpens the AI analysis
  contractType     String? // slug from CONTRACT_TYPES, e.g. "nda", "freelance"
  perspective      String? // which side the user is on, e.g. "provider" | "client"
  riskScore        Int? // 0-100, higher = riskier
  riskLevel        RiskLevel?
  // Structured JSON result from the AI analysis (clauses, missing, tips)
  analysis         Json?
  // Cached AI-drafted negotiation email (Pro feature)
  negotiationEmail String?    @db.Text
  shareToken       String?    @unique
  createdAt        DateTime   @default(now())

  @@index([userId, createdAt])
}

// --- Auth.js standard models ---
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Records every processed Stripe webhook event id so retried/duplicate
// deliveries (Stripe resends on timeout, manual replays) are no-ops.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id, e.g. "evt_..."
  type        String
  processedAt DateTime @default(now())
}
